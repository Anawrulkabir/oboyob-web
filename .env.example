# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_
NEXT_PUBLIC_SITE_URL=https://oboyob.vercel.app

# ------------------------------------------------------- Customer login
# Email code login is always on. Turn these on after configuring them in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=0       # 1 = show "Continue with Google"
NEXT_PUBLIC_AUTH_FACEBOOK=0     # 1 = show "Continue with Facebook"
NEXT_PUBLIC_AUTH_PHONE=0        # 1 = show mobile-number login (needs an SMS provider in Supabase → Phone)

# ------------------------------------------------ Notifications (all optional)
# Seller: Telegram bot — free, instant push on your phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email — pick ONE (the first one set is used):
#  Gmail  (free ~500/day, no domain): SMTP_USER = your Gmail, SMTP_PASS = a Gmail App Password
#         (Google Account → Security → 2-Step Verification on → App passwords). Leave EMAIL_FROM empty.
#         Any other SMTP server works too: also set SMTP_HOST / SMTP_PORT.
#  Brevo  (free 300/day, no domain needed: verify your sender email in Brevo) → BREVO_API_KEY
#  Resend (free 3,000/month, needs your own domain verified)                 → RESEND_API_KEY
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="অবয়ব <orders@yourdomain.com>"
SELLER_EMAIL=you@example.com

# Customer SMS — any BD gateway with an HTTP GET API (paid). {number} = 8801XXXXXXXXX
# SMS_API_URL=https://gateway.example/api/send?api_key=KEY&senderid=ID&number={number}&message={message}
SMS_API_URL=
# Phone-login OTPs via the same gateway (Supabase Auth → Hooks → Send SMS)
SUPABASE_SMS_HOOK_SECRET=
